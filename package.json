{
  "name": "dsh-restart-button",
  "version": "0.1.0",
  "description": "侧边栏底部的一键重启：完全退出 DeepSeek Harness 再把新实例拉起来（非官方插件）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "client",
    "tools",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "sync": "node tools/sync.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "restart",
    "重启"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
